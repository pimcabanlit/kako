# Copy to .env (gitignored) or export in your shell. Never commit real values.

# Meko: the MCP server Claude Code and the app use. Local Meko by default
# (dev and tests); Meko Cloud only for the demo datapack.
MEKO_MCP_URL=http://127.0.0.1:7777/mcp
# Local: the output of `meko token`. Cloud: an API key from cloud.mekodata.ai.
MEKO_API_KEY=
# The datapack every call names (a UUID); empty uses the account's default datapack.
KAKO_MEKO_DATAPACK_ID=
# The most calls this environment may make to each of Meko Cloud's Free-tier-capped tools
# (searches, saved turns, conversations, memory_add), counted in the database. 0 refuses them all;
# set it for the demo only. Local Meko has no ceiling.
KAKO_MEKO_CLOUD_CEILING=0
# Meko Cloud's Langfuse project id, for "See the trace" links (memory_get_all returns it).
KAKO_MEKO_LANGFUSE_PROJECT_ID=

# Postgres for the backend. postgresql:// is accepted and switched to the asyncpg driver.
# Local: postgresql+asyncpg://<user>:<password>@127.0.0.1:5432/kako
KAKO_DATABASE_URL=

# Web app (web/): where the backend listens. /api/v1/* is passed through to it.
KAKO_API_URL=http://127.0.0.1:8000

# Azure AI Foundry (docs/azure-setup.md). The resource endpoint; the project endpoint also works.
KAKO_FOUNDRY_ENDPOINT=
# Deployment names: the stronger one (orchestrator, dreaming) and the faster one (specialists).
KAKO_MODEL_STRONG=
KAKO_MODEL_FAST=
# Kako's own app registration (kako-dev). Leave all three empty to sign in with `az login`.
KAKO_AZURE_TENANT_ID=
KAKO_AZURE_CLIENT_ID=
KAKO_AZURE_CLIENT_SECRET=

# How models are reached: live (Foundry), record (Foundry, saving each reply to the file below;
# it costs money) or replay (the file's recorded replies: no network, no Azure settings needed).
KAKO_MODEL_MODE=live
KAKO_RECORDED_RESPONSES=
# Replay refuses a recorded reply whose request has changed since it was recorded.
KAKO_REPLAY_STRICT=true
# Spend controls: tokens one planning turn may use (all its calls together), and US$ of real model
# calls per UTC day (summed from llm_call; replays cost nothing). Raising either: say so in the PR.
KAKO_TURN_TOKEN_BUDGET=200000
KAKO_DAILY_SPEND_CAP_USD=3
# Retries after a rate limit, timeout or server error (0 to 3), and each attempt's timeout.
KAKO_MODEL_MAX_RETRIES=2
KAKO_MODEL_TIMEOUT_SECONDS=60
# Hidden reasoning per tier: none, minimal, low, medium or high (empty: the model's default).
KAKO_REASONING_EFFORT_STRONG=low
KAKO_REASONING_EFFORT_FAST=low
# US$ per million tokens, per tier, for llm_call.cost_usd. Defaults: OpenAI's list prices for
# gpt-5.4 and gpt-5-mini (Nov 2026). Check Azure's pricing page for your deployment type.
# Never 0: a free price would turn the daily cap off.
KAKO_PRICE_STRONG_INPUT=2.50
KAKO_PRICE_STRONG_CACHED=0.25
KAKO_PRICE_STRONG_OUTPUT=15.00
KAKO_PRICE_FAST_INPUT=0.25
KAKO_PRICE_FAST_CACHED=0.025
KAKO_PRICE_FAST_OUTPUT=2.00
