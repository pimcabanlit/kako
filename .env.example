# Copy to .env (gitignored) or export in your shell. Never commit real values.

# Meko: the MCP server Claude Code and the app use. Local Meko by default
# (dev and tests); Meko Cloud only for the demo datapack.
MEKO_MCP_URL=http://127.0.0.1:7777/mcp
# Local: the output of `meko token`. Cloud: an API key from cloud.mekodata.ai.
MEKO_API_KEY=
# true: the app runs without Meko (a laptop with no Meko to reach, such as Windows). Sessions are
# kept in Kako only, a turn has no Meko search and an approval no Meko upkeep.
KAKO_MEKO_OFF=false
# The datapack every call names (a UUID); empty uses the account's default datapack.
KAKO_MEKO_DATAPACK_ID=
# The most calls this environment may make to each of Meko Cloud's Free-tier-capped tools
# (searches, saved turns, conversations, memory_add), counted in the database. 0 refuses them all;
# set it for the demo only. Local Meko has no ceiling.
KAKO_MEKO_CLOUD_CEILING=0
# Meko Cloud's Langfuse project id, for "See the trace" links (memory_get_all returns it).
KAKO_MEKO_LANGFUSE_PROJECT_ID=

# Postgres for the backend. postgresql:// is accepted and switched to the asyncpg driver.
# Local: postgresql+asyncpg://<user>:<password>@127.0.0.1:5432/kako
KAKO_DATABASE_URL=

# Web app (web/): where the backend listens. /api/v1/* is passed through to it.
KAKO_API_URL=http://127.0.0.1:8000

# Where the agents' models run: anthropic (Claude on Anthropic's API, the default) or foundry
# (OpenAI models on Azure AI Foundry, docs/azure-setup.md).
KAKO_MODEL_PROVIDER=anthropic
# Models (Claude) or deployment names (Foundry): the stronger one (orchestrator, dreaming) and the
# faster one (specialists). Empty: Claude Opus 5.5 and Claude Haiku 5.5; Foundry needs its names.
KAKO_MODEL_STRONG=claude-opus-5-5
KAKO_MODEL_FAST=claude-haiku-5-5
# Claude: a key from the Claude Console (API keys). Kako reads only this KAKO_ name, never
# ANTHROPIC_API_KEY, which Claude Code uses for its own sign-in. Set a spend limit in the Console.
KAKO_ANTHROPIC_API_KEY=
# How hard Claude thinks per tier: low, medium, high, xhigh or max (thinking is always on).
KAKO_CLAUDE_EFFORT_STRONG=low
KAKO_CLAUDE_EFFORT_FAST=low

# Azure AI Foundry, with KAKO_MODEL_PROVIDER=foundry. The resource endpoint; the project endpoint
# also works.
KAKO_FOUNDRY_ENDPOINT=
# Kako's own app registration (kako-dev). Leave all three empty to sign in with `az login`.
KAKO_AZURE_TENANT_ID=
KAKO_AZURE_CLIENT_ID=
KAKO_AZURE_CLIENT_SECRET=
# Foundry's hidden reasoning per tier: none, minimal, low, medium or high (empty: the default).
KAKO_REASONING_EFFORT_STRONG=low
KAKO_REASONING_EFFORT_FAST=low

# How models are reached: live (the provider), record (the provider, saving each reply to the file
# below; it costs money) or replay (the file's recorded replies: no network, no key needed).
KAKO_MODEL_MODE=live
KAKO_RECORDED_RESPONSES=
# Replay refuses a recorded reply whose request has changed since it was recorded.
KAKO_REPLAY_STRICT=true
# Spend controls: tokens one planning turn may use (all its calls together), and US$ of real model
# calls per UTC day (summed from llm_call; replays cost nothing). Raising either: say so in the PR.
KAKO_TURN_TOKEN_BUDGET=200000
KAKO_DAILY_SPEND_CAP_USD=3
# Retries after a rate limit, timeout or server error (0 to 3), and each attempt's timeout.
KAKO_MODEL_MAX_RETRIES=2
KAKO_MODEL_TIMEOUT_SECONDS=60
# US$ per million tokens, per tier, for llm_call.cost_usd: input, cache reads, cache writes and
# output. Defaults: Anthropic's list prices for Claude Opus 5.5 and Claude Haiku 5.5 (Nov 2026);
# cache writes are 1.25 times input (the 5-minute cache). For Foundry, set OpenAI's: gpt-5.4
# 2.50 / 0.25 / 15.00 and gpt-5-mini 0.25 / 0.025 / 2.00 (Foundry has no cache writes).
# Never 0: a free price would turn the daily cap off.
KAKO_PRICE_STRONG_INPUT=4.00
KAKO_PRICE_STRONG_CACHED=0.20
KAKO_PRICE_STRONG_CACHE_WRITE=5.00
KAKO_PRICE_STRONG_OUTPUT=20.00
KAKO_PRICE_FAST_INPUT=0.10
KAKO_PRICE_FAST_CACHED=0.01
KAKO_PRICE_FAST_CACHE_WRITE=0.125
KAKO_PRICE_FAST_OUTPUT=0.50
# The brief every agent starts a turn from, in estimated tokens, and the results of its one
# context_search on the household's message.
KAKO_BRIEF_TOKEN_BUDGET=3000
KAKO_BRIEF_SEARCH_LIMIT=5
# The session's earlier turns the orchestrator reads before the new message, in estimated tokens:
# word for word within it (the last 8 always), older ones compacted by code to one line each.
KAKO_HISTORY_TOKEN_BUDGET=12000
# The folder read_document reads the household's documents from (statements/*.csv, kb/*.md), so
# answers can cite them with Meko off. Empty: the demo household's, data/demo-household.
KAKO_DOCUMENTS_DIR=
# The most a model may write in one call, reasoning included: a specialist and the orchestrator.
KAKO_SPECIALIST_MAX_OUTPUT_TOKENS=4000
KAKO_ORCHESTRATOR_MAX_OUTPUT_TOKENS=6000
